 using namespace love;
 
+/*
+** On 3DS an ImageData holds pixels the way the GPU samples them: padded to a
+** power-of-two width and height, laid out in 8x8 Morton-order tiles, each
+** RGBA8 pixel packed as R<<24 | G<<16 | B<<8 | A (bytes A,B,G,R in memory).
+** setPixel/getPixel/paste and Texture creation all assume that, but decoders
+** hand back plain row-major R,G,B,A and encoders expect the same, so the
+** two conversions below run at those boundaries.  (Before PNG decoding was
+** enabled on 3DS only pre-tiled .t3x files were ever decoded, so nothing
+** exercised this.)
+*/
+static std::unique_ptr<uint8_t[]> linearToTiledRGBA8(const uint8_t* linear, int width,
+                                                     int height, size_t& outSize)
+{
+    outSize        = love::GetPixelFormatSliceSize(PIXELFORMAT_RGBA8_UNORM, width, height);
+    auto tiled     = std::make_unique<uint8_t[]>(outSize);
+    const auto pow = NextPo2(width);
+
+    std::memset(tiled.get(), 0, outSize);
+
+    for (int y = 0; y < height; y++)
+    {
+        for (int x = 0; x < width; x++)
+        {
+            const uint8_t* src = linear + ((size_t)y * width + x) * 4;
+            auto* dst          = Color::FromTile<uint32_t>(tiled.get(), pow, { (float)x, (float)y });
+
+            *dst = ((uint32_t)src[0] << 24) | ((uint32_t)src[1] << 16) |
+                   ((uint32_t)src[2] << 8) | (uint32_t)src[3];
+        }
+    }
+
+    return tiled;
+}
+
+static void tiledToLinearRGBA8(const uint8_t* tiled, int width, int height, uint8_t* linear)
+{
+    const auto pow = NextPo2(width);
+
+    for (int y = 0; y < height; y++)
+    {
+        for (int x = 0; x < width; x++)
+        {
+            const uint32_t packed =
+                *Color::FromTile<uint32_t>(tiled, pow, { (float)x, (float)y });
+            uint8_t* dst = linear + ((size_t)y * width + x) * 4;
+
+            dst[0] = (packed >> 24) & 0xFF;
+            dst[1] = (packed >> 16) & 0xFF;
+            dst[2] = (packed >> 8) & 0xFF;
+            dst[3] = packed & 0xFF;
+        }
+    }
+}
+
