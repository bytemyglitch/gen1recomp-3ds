 {
-    return 0;
+    const int sampleRate  = luaL_checkinteger(L, 1);
+    const int bitDepth    = luaL_checkinteger(L, 2);
+    const int channels    = luaL_checkinteger(L, 3);
+    const int bufferCount = luaL_optinteger(L, 4, 0);
+
+    if (sampleRate <= 0)
+        return luaL_error(L, "Invalid sample rate: %d", sampleRate);
+
+    if (bitDepth != 8 && bitDepth != 16)
+        return luaL_error(L, "Invalid bit depth: %d (must be 8 or 16)", bitDepth);
+
+    if (channels != 1 && channels != 2)
+        return luaL_error(L, "Invalid channel count: %d (must be 1 or 2)", channels);
+
+    ::Source* self = nullptr;
+
+    luax::CatchException(L, [&]() {
+        self = instance()->NewSource(sampleRate, bitDepth, channels, bufferCount);
+    });
+
+    if (!self)
+        return luaL_error(L, "Could not create a queueable source.");
+
+    luax::PushType(L, self);
+    self->Release();
+
+    return 1;
 }
 
