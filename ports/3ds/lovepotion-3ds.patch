+
+void love::Thread::Join()
+{
+    if (this->thread == nullptr)
+        return;
+
+    threadJoin(this->thread, U64_MAX);
+    threadFree(this->thread);
+    this->thread = nullptr;
+}
+
+love::Thread::~Thread()
+{
+    this->Join();
+}
+
+void love::Thread::Wait()
+{
+    {
+        std::unique_lock lock(this->mutex);
+
