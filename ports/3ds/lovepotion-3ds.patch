 #include <utilities/shaper/genericshaper.hpp>
 
 #include <cmath>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
 
 using namespace love;
 
+/*
+** Every rasterizer used to linearAlloc and fix up its own copy of the font
+** data -- ~3 MB for the system font -- so a game creating a font per text
+** size ran the linear heap dry after a handful, linearAlloc returned NULL and
+** the memcpy into it took the whole console down.  Rasterizers built from the
+** same Data now share one fixed-up copy, freed with the last of them.  Keying
+** by the source buffer is safe: each rasterizer keeps its Data alive.
+*/
+namespace
+{
+    struct SharedFace
+    {
+        CFNT_s* face;
+        size_t references;
+    };
+
+    std::mutex sharedFacesMutex;
+    std::unordered_map<const void*, SharedFace> sharedFaces;
+
+    CFNT_s* acquireFace(Data* data)
+    {
+        std::lock_guard<std::mutex> lock(sharedFacesMutex);
+
+        const void* key = data->GetData();
+        auto found      = sharedFaces.find(key);
+
+        if (found != sharedFaces.end())
+        {
+            found->second.references++;
+            return found->second.face;
+        }
+
+        auto* face = (CFNT_s*)linearAlloc(data->GetSize());
+        if (face == nullptr)
+            throw love::Exception("Not enough linear memory for font data (%u bytes).",
+                                  (unsigned)data->GetSize());
+
+        std::memcpy((uint8_t*)face, data->GetData(), data->GetSize());
+        fontFixPointers(face);
+
+        sharedFaces.emplace(key, SharedFace { face, 1 });
+        return face;
+    }
+
+    void releaseFace(const void* key)
+    {
+        std::lock_guard<std::mutex> lock(sharedFacesMutex);
+
+        auto found = sharedFaces.find(key);
+        if (found == sharedFaces.end())
+            return;
+
+        if (--found->second.references == 0)
+        {
+            linearFree(found->second.face);
+            sharedFaces.erase(found);
+        }
+    }
+} // namespace
