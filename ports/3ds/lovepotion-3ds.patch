+void Source<Console::CTR>::InitQueueBuffers(int count)
+{
+    if (count < 1)
+        count = DEFAULT_QUEUE_BUFFERS;
+    else if (count > MAX_QUEUE_BUFFERS)
+        count = MAX_QUEUE_BUFFERS;
+
+    this->bufferCount = count;
+
+    this->queueBuffers.assign(count, ndspWaveBuf {});
+    this->queueCapacity.assign(count, 0);
+    this->queuePending.clear();
+
+    for (auto& buffer : this->queueBuffers)
+        buffer.status = NDSP_WBUF_DONE;
+}
+
+/* ndspChnReset / ndspChnWaveBufClear unlink buffers without updating their status */
+void Source<Console::CTR>::ResetQueueBuffers()
+{
+    this->queuePending.clear();
+
+    for (auto& buffer : this->queueBuffers)
+        buffer.status = NDSP_WBUF_DONE;
+}
+
+bool Source<Console::CTR>::IsQueueSlotFree(size_t index) const
+{
+    const auto status = this->queueBuffers[index].status;
+    if (status != NDSP_WBUF_DONE && status != NDSP_WBUF_FREE)
+        return false;
+
+    return std::find(this->queuePending.begin(), this->queuePending.end(), index) ==
+           this->queuePending.end();
+}
+
+void Source<Console::CTR>::SubmitPendingAtomic()
+{
+    while (!this->queuePending.empty())
+    {
+        const size_t index = this->queuePending.front();
+        this->queuePending.pop_front();
+
+        ::DSP::Instance().ChannelAddBuffer(this->channel, &this->queueBuffers[index]);
+    }
 }
 
