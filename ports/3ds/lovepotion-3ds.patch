+void love::Thread::Entry(void* data)
+{
+    love::Thread::Runner(data);
+}
+
+/*
+** Where a worker runs.  New 3DS: core 2, a whole core of its own.  Otherwise
+** (or if the kernel refuses core 2) the main thread's core, one priority
+** step ABOVE the main thread, so it preempts the game loop whenever it has
+** work instead of waiting for vblank; the LOVE workers block on channels or
+** sleep when idle, so that costs the game only the work they actually do.
+*/
+static Thread_tag* createWorker(ThreadFunc entry, void* arg)
+{
+    constexpr size_t STACK_SIZE = 0x40000;
+
+    int32_t priority = 0x30;
+    svcGetThreadPriority(&priority, CUR_THREAD_HANDLE);
+
+    bool isNew3DS = false;
+    APT_CheckNew3DS(&isNew3DS);
+
+    if (isNew3DS)
+    {
+        Thread_tag* handle = threadCreate(entry, arg, STACK_SIZE, priority, 2, false);
+        if (handle != nullptr)
+            return handle;
+    }
+
+    const int32_t raised = priority > 0x19 ? priority - 1 : priority;
+    return threadCreate(entry, arg, STACK_SIZE, raised, -2, false);
+}
+
+bool love::Thread::Start()
+{
+    std::unique_lock lock(this->mutex);
+
+    if (this->running)
+        return false;
+
+    this->Join();
+
+    this->threadable->Retain();
+
+    this->running = true;
+    this->thread  = createWorker(&love::Thread::Entry, this);
+
+    if (this->thread == nullptr)
+    {
+        this->running = false;
+        this->threadable->Release();
+    }
+
+    return this->running;
+}
+#else
 love::Thread::Thread(Threadable* threadable) : threadable(threadable), running(false), thread {}
 {}
 
